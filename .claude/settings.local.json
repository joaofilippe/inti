      "Bash(mv internal/cache internal/infra/cache)",
      "Bash(mv internal/database internal/infra/database)",
      "Bash(mv internal/server internal/infra/server)",
      "Bash(mv internal/repository internal/infra/repository)",
      "Bash(go version:*)",
