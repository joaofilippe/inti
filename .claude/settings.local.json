      "Bash(mv internal/service internal/infra/service)",
      "Bash(find . -name \"*.go\" -exec sed -i 's|\"github.com/joaofilippe/inti/internal/repository\"|\"github.com/joaofilippe/inti/internal/infra/repository\"|g; s|\"github.com/joaofilippe/inti/internal/service\"|\"github.com/joaofilippe/inti/internal/infra/service\"|g' {} +)",
      "Bash(dlv version:*)",
      "Bash(go install:*)",
      "Bash(docker compose:*)",
      "Bash(swag init:*)",
      "Bash(~/go/bin/swag init:*)",
      "Read(//c/tmp/**)",
