      "Bash(unzip -q /c/projects/go/inti/3NEG.docx -d 3NEG_extracted)",
      "Bash(ls -la /c/projects/go/inti/*.docx)",
      "Bash(xargs cat:*)",
      "Bash(xargs ls:*)",
      "Bash(cat)",
      "Bash(chmod +x /tmp/parse_atos.sh)",
      "Bash(/tmp/parse_atos.sh)",
      "Bash(awk '-F'\\\\''' '{for\\(i=1;i<=NF;i++\\) print \"Field \"i\": \" $i}')",
      "Bash(xargs grep *)"
    ]
  }
}
