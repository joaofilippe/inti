FROM node:20-alpine AS builder

ARG GITHUB_TOKEN

RUN apk add --no-cache git

WORKDIR /app
RUN git clone https://${GITHUB_TOKEN}@github.com/joaofilippe/inti-front.git .

RUN npm ci || npm install
RUN npm run build

FROM nginx:alpine
# Copia o build do Angular para o diretório padrão do Nginx
# O outputPath default em novos projetos Angular é dist/nome-do-projeto/browser
COPY --from=builder /app/dist/inti-front/browser /usr/share/nginx/html
# Escreve a configuração customizada do Nginx com suporte a SPA e proxy reverso /api
RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    client_max_body_size 100M;\n\
\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html index.htm;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location /api/ {\n\
        proxy_pass http://backend:8080;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_read_timeout 300s;\n\
        proxy_connect_timeout 300s;\n\
        proxy_send_timeout 300s;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

