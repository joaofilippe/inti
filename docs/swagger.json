                "DataCumprimento": {
                    "type": "string"
                },
                "Horario": {
                    "type": "string"
                },
                "NomeAto": {
                    "type": "string"
                }
            }
        },
        "dto.ContatoDTO": {
            "type": "object",
            "properties": {
                "IsTerceiro": {
                    "type": "boolean"
                },
                "NomeTerceiro": {
                    "type": "string"
                },
                "RelacaoTerceiro": {
                    "type": "string"
                },
                "Tipo": {
                    "type": "string"
                },
                "Valor": {
                    "type": "string"
                }
            }
        },
        "dto.MandadoExtraido": {
            "type": "object",
            "properties": {
                "Cidade": {
                    "type": "string"
                },
                "Documento": {
                    "type": "string"
                },
                "Endereco": {
                    "type": "string"
                },
                "Mandado": {
                    "type": "string"
                },
                "Nome": {
                    "type": "string"
                },
                "Posicao": {
                    "type": "string"
                },
                "Sexo": {
                    "type": "string"
                }
            }
        },
        "dto.MandadoPositivoDTO": {
            "type": "object",
            "properties": {
                "Atos": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.AtoDTO"
                    }
                },
                "Cidade": {
                    "type": "string"
                },
                "Contato": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ContatoDTO"
                    }
                },
                "DataCarga": {
                    "type": "string"
                },
                "Diligencias": {
                    "type": "string"
                },
                "Documento": {
                    "type": "string"
                },
                "Endereco": {
                    "type": "string"
                },
                "IsPJ": {
                    "type": "boolean"
                },
                "Mandado": {
                    "type": "string"
                },
                "Nome": {
                    "type": "string"
                },
                "Obs": {
                    "type": "string"
                },
                "Posicao": {
                    "type": "string"
                },
                "RepresentanteDoc": {
                    "type": "string"
                },
                "RepresentanteNome": {
                    "type": "string"
                },
                "Sexo": {
                    "type": "string"
                },
                "Situacao": {
                    "type": "string"
                }
            }
        }
    }
}